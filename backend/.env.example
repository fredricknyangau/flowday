DATABASE_URL=postgresql://postgres:password@localhost:5432/flowday
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173
API_KEY=flowday-local-dev-key

# JWT authentication (required — no default)
# Generate with: python scripts/issue_dev_token.py --print-secret
# or: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
